{
  "name": "Back-End",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "test:db:preparar": "node tests/ambiente/banco.js preparar",
    "test:db:limpar": "node tests/ambiente/banco.js limpar",
    "test:ambiente": "node tests/ambiente/verificar.js",
    "test:evidencias": "node tests/ambiente/gerar-evidencias.js",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm --build testes",
    "test:volume": "node tests/ambiente/validar-volume-uploads.js",
    "test:seeders": "node tests/ambiente/validar-seeders.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/ambiente/variaveis.js"],
    "globalSetup": "<rootDir>/tests/ambiente/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/ambiente/globalTeardown.js",
    "testPathIgnorePatterns": ["/node_modules/", "/tests/ambiente/", "/tests/fixtures/"],
    "testTimeout": 20000,
    "collectCoverageFrom": ["src/**/*.js", "!src/migrations/**", "!src/seeders/**"],
    "coverageReporters": ["text-summary", "text"]
  }
}
