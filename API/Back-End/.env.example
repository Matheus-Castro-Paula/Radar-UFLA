# Copie este arquivo para .env e preencha os valores marcados como obrigatórios.
# O .env nunca vai para o Git (boundaries.md, regra 5).

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Rodando a API pelo Docker Compose: o compose já força DB_HOST=db e DB_PORT=3306
# dentro do container, então estes dois valores só valem fora do Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Obrigatório. Senha do MySQL. No Docker, vira a senha do root do container na
# PRIMEIRA vez que o volume mysql_data é criado (depois disso o MySQL ignora).
DB_PASSWORD=
DB_NAME=radar_ufla

# Porta do MySQL do Docker na sua máquina (só acessível por 127.0.0.1).
# Mude se a 3306 já estiver ocupada por um MySQL instalado localmente.
DB_PORTA_HOST=3306

# ---------------------------------------------------------------------------
# Testes (docker-compose.test.yml e npm run test:*)
# ---------------------------------------------------------------------------
# Obrigatório para o docker-compose.test.yml: senha do MySQL descartável de teste.
DB_TEST_PASSWORD=
DB_NAME_TEST=radar_ufla_test

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000
# Obrigatório: a API não sobe sem ele. Use um valor longo e aleatório.
JWT_SECRET=
